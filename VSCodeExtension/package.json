{
	"name": "lsp-sample-client",
	"description": "VSCode part of a language server",
	"author": "Microsoft Corporation",
	"license": "MIT",
	"version": "0.0.1",
	"publisher": "vscode",
	"repository": {
		"type": "git",
		"url": "https://github.com/Microsoft/vscode-extension-samples"
	},
	"engines": {
		"vscode": "^1.100.0"
	},
	"main": "./out/extension",
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -w -p ./"
	},
	"dependencies": {
		"glob": "^11.0.0",
		"vscode-languageclient": "^9.0.1"
	},
	"devDependencies": {
		"@types/vscode": "^1.100.0",
		"@types/node": "^22",
		"typescript": "^5.3.0"
	},
	"contributes": {
		"languages": [
			{
				"id": "glsl",
				"aliases": ["OpenGL Shading Language"],
				"extensions": [
					".glsl"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "glsl",
				"scopeName": "source.glsl",
				"path": "./syntaxes/glsl.tmLanguage.json"
			}
		],
		"configurationDefaults": {
			"editor.semanticHighlighting.enabled": true,
			"[glsl]": {
				"editor.semanticHighlighting.enabled": true
			}
		},
		"semanticTokenScopes": [
			{
				"language": "glsl",
				"scopes": {
					"primitive": ["storage.type"]
				}
			}
		]
	}
}
