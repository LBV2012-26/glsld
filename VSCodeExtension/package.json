{
	"name": "glsld",
	"displayName": "GLSL Language Server",
	"description": "GLSL language support with diagnostics, hover, completion, go-to-definition, and more",
	"author": "glsld",
	"publisher": "glsld",
	"version": "0.1.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/glsld/glsld"
	},
	"engines": {
		"vscode": "^1.100.0"
	},
	"main": "./out/extension",
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -w -p ./"
	},
	"dependencies": {
		"glob": "^11.0.0",
		"vscode-languageclient": "^9.0.1"
	},
	"devDependencies": {
		"@types/vscode": "^1.100.0",
		"@types/node": "^22",
		"typescript": "^5.3.0"
	},
	"contributes": {
		"languages": [
			{
				"id": "glsl",
				"aliases": ["OpenGL Shading Language", "GLSL"],
				"extensions": [
					".glsl",
					".vert",
					".frag",
					".comp",
					".geom",
					".tesc",
					".tese",
					".mesh",
					".task",
					".rgen",
					".rahit",
					".rchit",
					".rmiss",
					".rint",
					".rcall"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "glsl",
				"scopeName": "source.glsl",
				"path": "./syntaxes/glsl.tmLanguage.json"
			}
		],
		"configuration": {
			"title": "GLSL Language Server",
			"properties": {
				"glsld.server.path": {
					"type": "string",
					"default": "glsld",
					"description": "Path to the glsld language server executable."
				},
				"glsld.glslc.path": {
					"type": "string",
					"default": "",
					"description": "Path to glslc executable. Leave empty to auto-detect from VULKAN_SDK environment variable."
				},
				"glsld.diagnostics.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Enable diagnostic errors and warnings via glslc compilation."
				},
				"glsld.capabilities.inlayHints": {
					"type": "boolean",
					"default": true,
					"description": "Enable inlay hints provided by glsld."
				},
				"glsld.backgroundIndex.roots": {
					"type": "array",
					"default": [],
					"items": {
						"type": "string"
					},
					"description": "Workspace-relative or absolute directories included in the background index. No directories are indexed when this list is empty."
				},
				"glsld.shaderVariants": {
					"type": "object",
					"default": {},
					"description": "Shader macro variants. Also editable via the sidebar UI.",
					"patternProperties": {
						".*": {
							"type": "object",
							"description": "Macro definitions for this variant."
						}
					}
				},
						"glsld.compileMaxConcurrency": {
					"type": "number",
					"default": 0,
					"description": "Maximum concurrent glslc processes. 0 = auto (CPU core count)."
				}
			}
		},
		"configurationDefaults": {
			"editor.semanticHighlighting.enabled": true,
			"[glsl]": {
				"editor.semanticHighlighting.enabled": true,
				"editor.tabSize": 4,
				"editor.insertSpaces": true
			}
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "glsld-sidebar",
					"title": "GLSL Shader",
					"icon": "resources/icons/sidebar_icon.svg"
				}
			]
		},
		"views": {
			"glsld-sidebar": [
				{
					"id": "glsld.shaderVariant",
					"name": "Global Variant"
				},
				{
					"id": "glsld.fileVariant",
					"name": "File Variant"
				},
				{
					"id": "glsld.shaderConfig",
					"name": "Shader Config"
				},
				{
					"id": "glsld.compileGroups",
					"name": "Compile Groups"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "glsld.shaderVariant",
				"contents": "No shader variants configured.\n[Add Variant](command:glsld.addVariant)\nVariants let you define macro sets and switch between them for different build configurations.",
				"when": "workbenchState != empty"
			},
			{
				"view": "glsld.fileVariant",
				"contents": "No per-file macros yet.\n[Add Macro to Current File](command:glsld.addFileMacro)\nPer-file macros stack on top of the global variant.",
				"when": "workbenchState != empty"
			},
			{
				"view": "glsld.shaderConfig",
				"contents": "No shader config overrides yet.\n[Add Config for Current File](command:glsld.addShaderConfig)\nOverride shader stage, version, target env, or SPIR-V version per-file for includes without #version or #pragma shader_stage.",
				"when": "workbenchState != empty"
			},
			{
				"view": "glsld.compileGroups",
				"contents": "No compile groups configured.\n[Add Compile Group](command:glsld.addCompileGroup)\nCompile groups define source globs, the glslc command template, and optional build variants. They are saved in `.glsld/config.json`.",
				"when": "workbenchState != empty"
			}
		],
		"commands": [
			{
				"command": "glsld.selectVariant",
				"title": "Select Shader Variant",
				"category": "glsld"
			},
			{
				"command": "glsld.addVariant",
				"title": "Add Variant",
				"category": "glsld",
				"icon": "$(add)"
			},
			{
				"command": "glsld.editVariant",
				"title": "Edit Variant",
				"category": "glsld"
			},
			{
				"command": "glsld.removeVariantCmd",
				"title": "Delete Variant",
				"category": "glsld"
			},
			{
				"command": "glsld.refreshVariants",
				"title": "Refresh Variants",
				"category": "glsld",
				"icon": "$(refresh)"
			},
			{
				"command": "glsld.addFileMacro",
				"title": "Add Macro to Current File",
				"category": "glsld",
				"icon": "$(add)"
			},
			{
				"command": "glsld.editFileMacro",
				"title": "Edit Macro",
				"category": "glsld"
			},
			{
				"command": "glsld.deleteFileMacro",
				"title": "Delete Macro",
				"category": "glsld"
			},
			{
				"command": "glsld.removeFileFromList",
				"title": "Remove File",
				"category": "glsld"
			},
			{
				"command": "glsld.addShaderConfig",
				"title": "Add Shader Config",
				"category": "glsld",
				"icon": "$(add)"
			},
			{
				"command": "glsld.editShaderConfigProp",
				"title": "Edit Shader Config Property",
				"category": "glsld"
			},
			{
				"command": "glsld.removeShaderConfig",
				"title": "Remove Shader Config",
				"category": "glsld"
			},
			{
				"command": "glsld.generateShaderConfigs",
				"title": "Generate Shader Config Templates",
				"category": "glsld",
				"icon": "$(wand)"
			},
			{
				"command": "glsld.applyShaderConfigTemplate",
				"title": "Apply Shader Config Template...",
				"category": "glsld"
			},
			{
				"command": "glsld.addCompileGroup",
				"title": "Add Compile Group",
				"category": "glsld",
				"icon": "$(add)"
			},
			{
				"command": "glsld.editCompileGroup",
				"title": "Edit Compile Group",
				"category": "glsld"
			},
			{
				"command": "glsld.removeCompileGroup",
				"title": "Remove Compile Group",
				"category": "glsld"
			},
			{
				"command": "glsld.refreshCompileGroups",
				"title": "Refresh Compile Groups",
				"category": "glsld",
				"icon": "$(refresh)"
			},
			{
				"command": "glsld.compileWorkspace",
				"title": "Compile All to SPIR-V",
				"category": "glsld",
				"icon": "$(debug-start)"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "glsld.addVariant",
					"when": "view == glsld.shaderVariant",
					"group": "navigation@1"
				},
				{
					"command": "glsld.addFileMacro",
					"when": "view == glsld.fileVariant",
					"group": "navigation@1"
				},
				{
					"command": "glsld.addShaderConfig",
					"when": "view == glsld.shaderConfig",
					"group": "navigation@1"
				},
				{
					"command": "glsld.addCompileGroup",
					"when": "view == glsld.compileGroups",
					"group": "navigation@1"
				},
				{
					"command": "glsld.compileWorkspace",
					"when": "view == glsld.compileGroups",
					"group": "navigation@2"
				},
				{
					"command": "glsld.refreshCompileGroups",
					"when": "view == glsld.compileGroups",
					"group": "navigation@3"
				},
				{
					"command": "glsld.refreshVariants",
					"when": "view == glsld.shaderVariant || view == glsld.fileVariant || view == glsld.shaderConfig",
					"group": "navigation@2"
				}
			],
			"view/item/context": [
				{
					"command": "glsld.editVariant",
					"when": "viewItem == variant"
				},
				{
					"command": "glsld.removeVariantCmd",
					"when": "viewItem == variant"
				},
				{
					"command": "glsld.editFileMacro",
					"when": "viewItem == macro"
				},
				{
					"command": "glsld.deleteFileMacro",
					"when": "viewItem == macro"
				},
				{
					"command": "glsld.addFileMacro",
					"when": "viewItem == fileMacroFile",
					"group": "inline@1"
				},
				{
					"command": "glsld.removeFileFromList",
					"when": "viewItem == fileMacroFile"
				},
				{
					"command": "glsld.applyShaderConfigTemplate",
					"when": "viewItem == fileConfig"
				},
				{
					"command": "glsld.editShaderConfigProp",
					"when": "viewItem == configProp"
				},
				{
					"command": "glsld.removeShaderConfig",
					"when": "viewItem == fileConfig"
				},
				{
					"command": "glsld.editCompileGroup",
					"when": "viewItem == compileGroup"
				},
				{
					"command": "glsld.removeCompileGroup",
					"when": "viewItem == compileGroup"
				}
			]
		},
		"semanticTokenScopes": [
			{
				"language": "glsl",
				"scopes": {
					"primitive": ["storage.type"]
				}
			}
		]
	}
}
