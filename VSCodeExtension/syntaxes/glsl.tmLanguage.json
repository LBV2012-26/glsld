{
	"name": "GLSL",
	"scopeName": "source.glsl",
	"fileTypes": [
		"glsl",
		"vert",
		"frag",
		"geom",
		"tesc",
		"tese",
		"comp",
		"mesh",
		"task",
		"rgen",
		"rahit",
		"rchit",
		"rmiss",
		"rint",
		"rcall",
		"vsh",
		"fsh",
		"gsh",
		"vshader",
		"fshader",
		"gshader"
	],
	"patterns": [
		{
			"include": "#root_context"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.documentation.glsl",
					"begin": "///|//!",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.comment.glsl"
						}
					},
					"end": "$",
					"patterns": [
						{
							"include": "#documentation_tags"
						}
					]
				},
				{
					"name": "comment.block.documentation.glsl",
					"begin": "/\\*\\*|/\\*!",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.comment.begin.glsl"
						}
					},
					"end": "\\*/",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.comment.end.glsl"
						}
					},
					"patterns": [
						{
							"include": "#documentation_tags"
						}
					]
				},
				{
					"name": "comment.block.glsl",
					"begin": "/\\*",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.comment.begin.glsl"
						}
					},
					"end": "\\*/",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.comment.end.glsl"
						}
					}
				},
				{
					"name": "comment.line.double-slash.glsl",
					"begin": "//",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.comment.glsl"
						}
					},
					"end": "$",
					"patterns": [
						{
							"name": "keyword.other.comment-note.glsl",
							"match": "\\b(?:TODO|FIXME|HACK|NOTE|BUG|XXX)\\b"
						}
					]
				}
			]
		},
		"documentation_tags": {
			"patterns": [
				{
					"match": "((?:@|\\\\)param)\\s+(?:\\[(?:in|out|inout)\\]\\s*)?([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": {
							"name": "storage.type.class.documentation.glsl"
						},
						"2": {
							"name": "variable.parameter.documentation.glsl"
						}
					}
				},
				{
					"name": "storage.type.class.documentation.glsl",
					"match": "(?:@|\\\\)(?:brief|param|return|returns|retval|note|warning|see|since|deprecated|todo|bug|author|version|file|struct|fn|ref|code|endcode)\\b"
				},
				{
					"name": "keyword.other.comment-note.glsl",
					"match": "\\b(?:TODO|FIXME|HACK|NOTE|BUG|XXX)\\b"
				}
			]
		},
		"preprocessors": {
			"patterns": [
				{
					"name": "meta.preprocessor.include.glsl",
					"begin": "^(\\s*)(#)\\s*(include)\\b",
					"beginCaptures": {
						"2": {
							"name": "punctuation.definition.directive.glsl"
						},
						"3": {
							"name": "keyword.control.directive.include.glsl"
						}
					},
					"end": "$",
					"patterns": [
						{
							"name": "string.quoted.other.lt-gt.include.glsl",
							"begin": "<",
							"beginCaptures": {
								"0": {
									"name": "punctuation.definition.string.begin.glsl"
								}
							},
							"end": ">|(?=$)",
							"endCaptures": {
								"0": {
									"name": "punctuation.definition.string.end.glsl"
								}
							}
						},
						{
							"name": "string.quoted.double.include.glsl",
							"begin": "\"",
							"beginCaptures": {
								"0": {
									"name": "punctuation.definition.string.begin.glsl"
								}
							},
							"end": "\"|(?=$)",
							"endCaptures": {
								"0": {
									"name": "punctuation.definition.string.end.glsl"
								}
							}
						},
						{
							"include": "#preprocessor_context"
						}
					]
				},
				{
					"name": "meta.preprocessor.extension.glsl",
					"begin": "^(\\s*)(#)\\s*(extension)\\b",
					"beginCaptures": {
						"2": {
							"name": "punctuation.definition.directive.glsl"
						},
						"3": {
							"name": "keyword.control.directive.extension.glsl"
						}
					},
					"end": "$",
					"patterns": [
						{
							"name": "support.constant.extension-behavior.glsl",
							"match": "\\b(?:require|enable|warn|disable)\\b"
						},
						{
							"name": "punctuation.separator.key-value.glsl",
							"match": ":"
						},
						{
							"name": "entity.name.tag.extension.glsl",
							"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
						},
						{
							"include": "#comments"
						}
					]
				},
				{
					"name": "meta.preprocessor.version.glsl",
					"begin": "^(\\s*)(#)\\s*(version)\\b",
					"beginCaptures": {
						"2": {
							"name": "punctuation.definition.directive.glsl"
						},
						"3": {
							"name": "keyword.control.directive.version.glsl"
						}
					},
					"end": "$",
					"patterns": [
						{
							"name": "support.constant.language-profile.glsl",
							"match": "\\b(?:core|compatibility|es)\\b"
						},
						{
							"include": "#strings_and_numbers"
						},
						{
							"include": "#comments"
						}
					]
				},
				{
					"name": "meta.preprocessor.macro.function.glsl",
					"begin": "^(\\s*)(#)\\s*(define)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\()",
					"beginCaptures": {
						"2": {
							"name": "punctuation.definition.directive.glsl"
						},
						"3": {
							"name": "keyword.control.directive.define.glsl"
						},
						"4": {
							"name": "entity.name.function.preprocessor.glsl"
						}
					},
					"end": "(?<!\\\\)$",
					"patterns": [
						{
							"include": "#macro_parameters"
						},
						{
							"include": "#preprocessor_context"
						}
					]
				},
				{
					"name": "meta.preprocessor.macro.glsl",
					"begin": "^(\\s*)(#)\\s*(define)\\s+([A-Za-z_][A-Za-z0-9_]*)",
					"beginCaptures": {
						"2": {
							"name": "punctuation.definition.directive.glsl"
						},
						"3": {
							"name": "keyword.control.directive.define.glsl"
						},
						"4": {
							"name": "entity.name.constant.preprocessor.glsl"
						}
					},
					"end": "(?<!\\\\)$",
					"patterns": [
						{
							"include": "#preprocessor_context"
						}
					]
				},
				{
					"name": "meta.preprocessor.conditional.glsl",
					"begin": "^(\\s*)(#)\\s*(if|ifdef|ifndef|elif)\\b",
					"beginCaptures": {
						"2": {
							"name": "punctuation.definition.directive.glsl"
						},
						"3": {
							"name": "keyword.control.directive.conditional.glsl"
						}
					},
					"end": "(?<!\\\\)$",
					"patterns": [
						{
							"include": "#preprocessor_context"
						}
					]
				},
				{
					"name": "meta.preprocessor.glsl",
					"begin": "^(\\s*)(#)\\s*(core|else|endif|error|line|pragma|shader_stage|undef)\\b",
					"beginCaptures": {
						"2": {
							"name": "punctuation.definition.directive.glsl"
						},
						"3": {
							"name": "keyword.control.directive.glsl"
						}
					},
					"end": "(?<!\\\\)$",
					"patterns": [
						{
							"include": "#preprocessor_context"
						}
					]
				},
				{
					"name": "meta.preprocessor.glsl",
					"begin": "^(\\s*)(#)\\s*([A-Za-z_][A-Za-z0-9_]*)",
					"beginCaptures": {
						"2": {
							"name": "punctuation.definition.directive.glsl"
						},
						"3": {
							"name": "keyword.control.directive.glsl"
						}
					},
					"end": "(?<!\\\\)$",
					"patterns": [
						{
							"include": "#preprocessor_context"
						}
					]
				}
			]
		},
		"macro_parameters": {
			"name": "meta.preprocessor.macro.parameters.glsl",
			"begin": "\\G(\\()",
			"beginCaptures": {
				"1": {
					"name": "punctuation.section.parameters.begin.glsl"
				}
			},
			"end": "\\)",
			"endCaptures": {
				"0": {
					"name": "punctuation.section.parameters.end.glsl"
				}
			},
			"patterns": [
				{
					"name": "variable.parameter.preprocessor.glsl",
					"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
				},
				{
					"name": "punctuation.separator.comma.glsl",
					"match": ","
				}
			]
		},
		"preprocessor_context": {
			"patterns": [
				{
					"name": "keyword.operator.logical.defined.glsl",
					"match": "\\bdefined\\b"
				},
				{
					"name": "constant.character.escape.line-continuation.glsl",
					"match": "\\\\(?=\\r?$)"
				},
				{
					"include": "#comments"
				},
				{
					"include": "#strings_and_numbers"
				},
				{
					"include": "#operators"
				},
				{
					"name": "variable.other.preprocessor.glsl",
					"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
				}
			]
		},
		"strings_and_numbers": {
			"patterns": [
				{
					"name": "string.quoted.double.glsl",
					"begin": "\"",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.string.begin.glsl"
						}
					},
					"end": "\"|(?=$)",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.string.end.glsl"
						}
					},
					"patterns": [
						{
							"name": "constant.other.placeholder.glsl",
							"match": "%(?:[-+ #0]*[0-9]*(?:\\.[0-9]+)?[diuoxXfFeEgGaAcsp%])"
						},
						{
							"name": "constant.character.escape.glsl",
							"match": "\\\\(?:[abfnrtv?\"'\\\\]|[0-7]{1,3}|x[0-9A-Fa-f]+|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})"
						},
						{
							"name": "invalid.illegal.unknown-escape.glsl",
							"match": "\\\\."
						}
					]
				},
				{
					"name": "constant.numeric.float.hexadecimal.glsl",
					"match": "(?<![A-Za-z0-9_])0[xX](?:[0-9A-Fa-f]+(?:\\.[0-9A-Fa-f]*)?|\\.[0-9A-Fa-f]+)[pP][+-]?[0-9]+(?:[fF]|[lL][fF]|[hH][fF])?(?![A-Za-z0-9_])"
				},
				{
					"name": "constant.numeric.float.decimal.glsl",
					"match": "(?<![A-Za-z0-9_])(?:(?:[0-9]+\\.[0-9]*|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+)(?:[fF]|[lL][fF]|[hH][fF])?(?![A-Za-z0-9_])"
				},
				{
					"name": "constant.numeric.integer.binary.glsl",
					"match": "(?<![A-Za-z0-9_])0[bB][01]+(?:[uU](?:[lL]{1,2})?|[lL]{1,2}[uU]?)?(?![A-Za-z0-9_])"
				},
				{
					"name": "constant.numeric.integer.hexadecimal.glsl",
					"match": "(?<![A-Za-z0-9_])0[xX][0-9A-Fa-f]+(?:[uU](?:[lL]{1,2})?|[lL]{1,2}[uU]?)?(?![A-Za-z0-9_])"
				},
				{
					"name": "constant.numeric.integer.octal.glsl",
					"match": "(?<![A-Za-z0-9_])0[0-7]+(?:[uU](?:[lL]{1,2})?|[lL]{1,2}[uU]?)?(?![A-Za-z0-9_])"
				},
				{
					"name": "constant.numeric.integer.decimal.glsl",
					"match": "(?<![A-Za-z0-9_])[0-9]+(?:[uU](?:[lL]{1,2})?|[lL]{1,2}[uU]?)?(?![A-Za-z0-9_])"
				}
			]
		},
		"attributes": {
			"name": "meta.attribute.glsl",
			"begin": "\\[\\[",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.attribute.begin.glsl"
				}
			},
			"end": "\\]\\]",
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.attribute.end.glsl"
				}
			},
			"patterns": [
				{
					"name": "entity.other.attribute-name.glsl",
					"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
				},
				{
					"include": "#strings_and_numbers"
				},
				{
					"include": "#punctuation"
				}
			]
		},
		"layout_qualifiers": {
			"name": "meta.layout-qualifier.glsl",
			"begin": "\\b(layout)\\s*(\\()",
			"beginCaptures": {
				"1": {
					"name": "storage.modifier.layout.glsl"
				},
				"2": {
					"name": "punctuation.section.parens.begin.glsl"
				}
			},
			"end": "\\)",
			"endCaptures": {
				"0": {
					"name": "punctuation.section.parens.end.glsl"
				}
			},
			"patterns": [
				{
					"include": "#comments"
				},
				{
					"include": "#strings_and_numbers"
				},
				{
					"name": "support.constant.layout-qualifier.glsl",
					"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
				},
				{
					"name": "keyword.operator.assignment.glsl",
					"match": "="
				},
				{
					"name": "punctuation.separator.comma.glsl",
					"match": ","
				}
			]
		},
		"structures": {
			"patterns": [
				{
					"name": "meta.struct.glsl",
					"match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": {
							"name": "storage.type.struct.glsl"
						},
						"2": {
							"name": "entity.name.type.struct.glsl"
						}
					}
				},
				{
					"name": "meta.interface-block.glsl",
					"match": "\\b(uniform|buffer|in|out)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\{|;)",
					"captures": {
						"1": {
							"name": "storage.modifier.glsl"
						},
						"2": {
							"name": "entity.name.type.interface-block.glsl"
						}
					}
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.language.boolean.glsl",
					"match": "\\b(?:true|false)\\b"
				},
				{
					"name": "constant.language.null.glsl",
					"match": "\\bnull\\b"
				}
			]
		},
		"declarations": {
			"name": "meta.declaration.glsl",
			"match": "\\b((?!(?:return|case|discard|else|break|continue)\\b)[A-Za-z_][A-Za-z0-9_]*)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\[|=|,|;|\\))",
			"captures": {
				"1": {
					"patterns": [
						{
							"include": "#metadata_types"
						},
						{
							"name": "entity.name.type.glsl",
							"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
						}
					]
				},
				"2": {
					"name": "variable.other.glsl"
				}
			}
		},
		"user_functions": {
			"name": "meta.function-call.glsl",
			"begin": "\\b([A-Za-z_][A-Za-z0-9_]*)(\\s*)(\\()",
			"beginCaptures": {
				"1": {
					"name": "entity.name.function.call.glsl"
				},
				"3": {
					"name": "punctuation.section.arguments.begin.glsl"
				}
			},
			"end": "\\)",
			"endCaptures": {
				"0": {
					"name": "punctuation.section.arguments.end.glsl"
				}
			},
			"patterns": [
				{
					"include": "#expression_context"
				}
			]
		},
		"members": {
			"patterns": [
				{
					"match": "(?<=\\.)(\\s*)([xyzwrgbastpq]{1,4})\\b",
					"captures": {
						"2": {
							"name": "variable.other.member.swizzle.glsl"
						}
					}
				},
				{
					"match": "(?<=\\.)(\\s*)([A-Za-z_][A-Za-z0-9_]*)\\b",
					"captures": {
						"2": {
							"name": "variable.other.member.glsl"
						}
					}
				}
			]
		},
		"identifiers": {
			"name": "variable.other.glsl",
			"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
		},
		"operators": {
			"name": "keyword.operator.glsl",
			"match": "->|\\+\\+|--|<<=|>>=|<<|>>|<=|>=|==|!=|&&|\\|\\||\\^\\^|\\*=|/=|%=|\\+=|-=|&=|\\^=|\\|=|=|!|~|%|\\^|&|\\||\\*|/|-|\\+|\\?|:|\\.|<|>"
		},
		"punctuation": {
			"patterns": [
				{
					"name": "punctuation.terminator.statement.glsl",
					"match": ";"
				},
				{
					"name": "punctuation.separator.comma.glsl",
					"match": ","
				},
				{
					"name": "punctuation.section.parens.begin.glsl",
					"match": "\\("
				},
				{
					"name": "punctuation.section.parens.end.glsl",
					"match": "\\)"
				},
				{
					"name": "punctuation.section.braces.begin.glsl",
					"match": "\\{"
				},
				{
					"name": "punctuation.section.braces.end.glsl",
					"match": "\\}"
				},
				{
					"name": "punctuation.section.brackets.begin.glsl",
					"match": "\\["
				},
				{
					"name": "punctuation.section.brackets.end.glsl",
					"match": "\\]"
				}
			]
		},
		"metadata_types": {
			"comment": "Generated from primitive and built-in Metadata type lists. Do not edit this rule manually.",
			"patterns": [
				{
					"name": "storage.type.glsl",
					"match": "\\b(?:_Func|atomic_uint|bool|double|fixed|float|half|int|long|short|superp|uint|unsigned|void)\\b"
				},
				{
					"name": "entity.name.type.glsl",
